"use strict";
var images = document.querySelector(".gallery__list");
var largeImg = document.querySelector("#largeImg");
// eslint-disable-next-line no-shadow
images.addEventListener("click", function(event) {
    var link = event.target.closest(".list-item");
    var imagesHREf = link.querySelector("a").getAttribute("href");
    var imgSRC = link.querySelector("img").getAttribute("src");
    // console.log(imgSRC);
    event.preventDefault();
    largeImg.setAttribute("src", window.location.origin + imagesHREf || window.location.origin + imgSRC);
});

